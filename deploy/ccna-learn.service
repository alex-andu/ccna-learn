[Unit]
Description=CCNA Learn (platformă de învățare CCNA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ccna-learn
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/opt/ccna-learn/data
ExecStart=/usr/bin/node server/dist/index.js
Restart=on-failure
RestartSec=3
# memorie limitată ca să nu afecteze restul Pi-ului
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/ccna-learn/data

[Install]
WantedBy=multi-user.target
